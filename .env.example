# =============================================================
# Martinos Kos Assistant — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env to git.
# =============================================================

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Fallback keys (only used if SERVICE_ROLE_KEY is not set)
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=

# --- AI Provider ---
# OpenRouter only
AI_PROVIDER=openrouter

# --- OpenRouter AI ---
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_MODEL_FALLBACKS=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL=
ALLOW_PAID_OPENROUTER_MODELS=true
OPENROUTER_RPM_LIMIT=15

# --- WhatsApp Admin Numbers ---
# Comma-separated, digits only or with country code.
# Example: ADMIN_WA_NUMBERS=628123456789,628987654321
ADMIN_WA_NUMBERS=

# --- WhatsApp Admin Raw JIDs (fallback for @lid identity) ---
# Comma-separated WhatsApp JIDs used when WhatsApp sends a raw @lid sender.
# Example: ADMIN_WA_JIDS=628123456789@s.whatsapp.net,1234567890@lid
ADMIN_WA_JIDS=

# --- WhatsApp Session Folder ---
# Production recommendation: keep this outside the repo/deploy folder.
# Example on VM: WA_SESSION_DIR=/home/Dandy/martinos-wa-auth
WA_SESSION_DIR=

# --- WhatsApp Bot LID (multi-device support) ---
# Leave blank if unsure — the bot auto-detects its own number.
BOT_WA_LID=


# --- Martinos Kos WhatsApp Groups ---
# Get group JIDs by logging msg.key.remoteJid when the bot is in the group.
# Format: 1234567890-1234567890@g.us
MARTINOS_LISTRIK_NOMINAL=55000
MARTINOS_BANK_NAME=
MARTINOS_BANK_ACCOUNT=
MARTINOS_BANK_ACCOUNT_NAME=
MARTINOS_GROUP_1_JID=
MARTINOS_GROUP_2_JID=
MARTINOS_GROUP_3_JID=
MARTINOS_TECH_SUPPORT_NUMBER=08511771087

# --- Admin Personal WhatsApp JID (for receiving payment proof forwards) ---
# Format: 628xxxxxxxxx@s.whatsapp.net  (include the @s.whatsapp.net suffix)
# If this is missing, tenant proof upload will reply with a friendly error
# and will NOT crash the bot.
MARTINOS_ADMIN_WA_JID=

# --- Optional ---
NODE_ENV=development
OPENWEATHER_API_KEY=
WEATHER_API_KEY=
MONITOR_URL=
MONITOR_INTERVAL=300000
